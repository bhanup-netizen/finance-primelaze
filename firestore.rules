rules_version = '2';
// Primelaze dashboard — Firestore security rules.
// Paste these in Firebase Console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    // Bootstrap admin email is always admin; other admins are flagged in their
    // own users/{uid} doc. Keep this email in sync with BOOTSTRAP_ADMIN_EMAIL
    // in assets/js/firebase-config.js.
    function isBootstrapAdmin() {
      return isSignedIn() && request.auth.token.email == 'bhanup@primelaze.com';
    }
    function userRole() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : '';
    }
    // Admin = full content edit (role 'admin' or 'superadmin', or bootstrap).
    function isAdmin() {
      return isBootstrapAdmin() || userRole() == 'admin' || userRole() == 'superadmin';
    }
    // Super Admin = also manages users. Bootstrap email is always super.
    function isSuperAdmin() {
      return isBootstrapAdmin() || userRole() == 'superadmin';
    }
    // A "view" user granted edit rights on one or more pages (page admin).
    function isPageEditor() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.editPages == 'all'
            || (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.editPages is list
                && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.editPages.size() > 0));
    }

    // App config (holds the data-decryption key) — any signed-in user may read;
    // only admins may write.
    match /config/{doc} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Shared edits/overrides — signed-in users read; admins and page editors
    // write. (Page editors can technically write any field in the shared doc;
    // acceptable for an internal team tool.)
    match /edits/{doc} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isPageEditor();
    }

    // Delivery challans — any signed-in user may read/download; admins write.
    match /challans/{doc} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // User permission docs.
    //  - Read: own doc; admins/super and page editors read the list (to manage).
    //  - Super admins: full create/update/delete of any account.
    //  - Page editors: may create/update/delete VIEW users only (they can add
    //    viewers for their pages). The role=='view' guard blocks any attempt to
    //    mint or elevate an admin/super via this path.
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin() || isPageEditor());
      allow create, update: if isSuperAdmin()
        || (isPageEditor() && request.resource.data.role == 'view');
      allow delete: if isSuperAdmin()
        || (isPageEditor() && resource.data.role == 'view');
    }
  }
}
