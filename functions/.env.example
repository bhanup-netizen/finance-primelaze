# Copy this file to functions/.env and fill in real values.
# These NON-SECRET config values are deployed with the function.
# The two SECRETS (WHATSAPP_TOKEN, MSG91_AUTHKEY) are NOT set here — set them
# with `firebase functions:secrets:set NAME` (see MESSAGING-setup.md).

# ---- WhatsApp (Meta WhatsApp Cloud API) ----
# From Meta > WhatsApp > API setup. The "Phone number ID" (numeric), NOT the number.
WHATSAPP_PHONE_ID=
# Name of your approved message template (utility category).
WHATSAPP_TEMPLATE=order_dispatched
# Template language code (e.g. en, en_US, en_GB).
WHATSAPP_LANG=en
# Graph API version (leave as-is unless Meta deprecates it).
WHATSAPP_GRAPH_VERSION=v21.0

# ---- SMS (MSG91 flow API v5) ----
# The DLT-approved flow/template id from MSG91.
MSG91_TEMPLATE_ID=
# Your 6-character DLT-registered sender/header id (e.g. CSOVIL).
MSG91_SENDER=
