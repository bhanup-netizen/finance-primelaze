# Netlify cache headers.
# index.html must NEVER be cached, so the app.js/css version bumps always take
# effect and everyone gets the latest deploy without a hard refresh.
/
  Cache-Control: no-cache, max-age=0, must-revalidate
/index.html
  Cache-Control: no-cache, max-age=0, must-revalidate

# Versioned assets (app.js?v=…, styles.css?v=…) can be cached hard — the query
# string changes on every release, so a cached copy is never stale.
/assets/*
  Cache-Control: public, max-age=31536000
